{
  "name": "documind",
  "version": "0.1.0",
  "private": true,
  "description": "DocuMind — Document Intelligence & Ingestion Platform",
  "type": "module",
  "packageManager": "npm@11.0.0",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "build:api": "npm run build -w apps/api",
    "start:api": "npm run start -w apps/api",
    "test:api": "npm run test -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "test:web": "npm run test -w apps/web",
    "migrate": "npm run migrate -w apps/api",
    "eval": "npm run eval -w apps/api"
  }
}
