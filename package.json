{
  "name": "documind",
  "version": "0.1.0",
  "private": true,
  "description": "DocuMind — Document Intelligence & Ingestion Platform",
  "type": "module",
  "packageManager": "npm@11.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "build:server": "npm run build -w server",
    "start:server": "npm run start -w server",
    "test:server": "npm run test -w server",
    "dev:client": "npm run dev -w client",
    "build:client": "npm run build -w client",
    "test:client": "npm run test -w client",
    "migrate": "npm run migrate -w server",
    "eval": "npm run eval -w server"
  }
}
