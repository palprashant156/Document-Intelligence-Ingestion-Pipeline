# Copy to .env and fill in. Never commit .env.
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Local Postgres (no Docker). Example:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/documind

# Local file storage
STORAGE_DIR=./storage/uploads
TEMP_DIR=./storage/temporary
MAX_FILE_SIZE_BYTES=10485760
MAX_FILES_PER_REQUEST=5

# Embeddings: mock is default (no key needed).
EMBEDDING_PROVIDER=mock
MOCK_EMBEDDING_DIM=128
# Only needed when EMBEDDING_PROVIDER=gemini (backend only, never expose to browser):
# GEMINI_API_KEY=
# GEMINI_EMBEDDING_MODEL=text-embedding-004
